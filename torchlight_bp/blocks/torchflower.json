{
    "format_version": "1.21.120",
    "minecraft:block": {
        "description": {
            "identifier": "torchlight:torchflower",
            "menu_category": {
                "category": "none"
            }
        },
        "components": {
          "minecraft:light_dampening": 0,
            "minecraft:light_emission": 14,

            "minecraft:geometry": "geometry.torchflower",
            "minecraft:material_instances": {
